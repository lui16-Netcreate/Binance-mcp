//@version=5
strategy(
     title             = "RSI + Fibonacci Confluence Backtest",
     shorttitle        = "RSI+Fib Backtest",
     overlay           = true,
     initial_capital   = 10000,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.1
 )

// ── Inputs ────────────────────────────────────────────────────────────────────
rsi_length    = input.int(14,   title="RSI Length",            group="RSI Settings")
rsi_threshold = input.int(30,   title="RSI Oversold Level",    group="RSI Settings")
fib_lookback  = input.int(100,  title="Fibonacci Lookback (bars)", group="Fibonacci Settings")
tp_pct        = input.float(5.0, title="Take Profit %", step=0.5,  group="Exit Settings")
sl_pct        = input.float(3.0, title="Stop Loss %",   step=0.5,  group="Exit Settings")
show_table    = input.bool(true, title="Show Stats Table",     group="Display")
show_fib_zone = input.bool(true, title="Show Fibonacci Zone",  group="Display")

// ── RSI ───────────────────────────────────────────────────────────────────────
rsi = ta.rsi(close, rsi_length)
rsi_signal = rsi <= rsi_threshold

// ── Fibonacci golden zone ─────────────────────────────────────────────────────
swing_high = ta.highest(high, fib_lookback)
swing_low  = ta.lowest(low,  fib_lookback)
fib_range  = swing_high - swing_low
fib_0618   = swing_high - 0.618 * fib_range
fib_0786   = swing_high - 0.786 * fib_range
fib_signal = close <= fib_0618 and close >= fib_0786

// ── Confluence ────────────────────────────────────────────────────────────────
confluence = rsi_signal and fib_signal

// ── Signal counters ───────────────────────────────────────────────────────────
var int count_rsi        = 0
var int count_fib        = 0
var int count_confluence = 0
var int count_bars       = 0

count_bars += 1
if rsi_signal and not fib_signal
    count_rsi += 1
if fib_signal and not rsi_signal
    count_fib += 1
if confluence
    count_confluence += 1

// ── Plot fibonacci zone ───────────────────────────────────────────────────────
p618 = plot(show_fib_zone ? fib_0618 : na, title="Fib 0.618", color=color.new(color.yellow, 50), linewidth=1)
p786 = plot(show_fib_zone ? fib_0786 : na, title="Fib 0.786", color=color.new(color.orange, 50), linewidth=1)
fill(p618, p786, color=color.new(color.yellow, 85), title="Golden Zone")

// ── Plot RSI oversold background ──────────────────────────────────────────────
bgcolor(rsi_signal and not confluence ? color.new(color.blue,  90) : na, title="RSI Only")
bgcolor(fib_signal and not confluence ? color.new(color.orange,90) : na, title="Fib Only")
bgcolor(confluence                    ? color.new(color.green, 80) : na, title="Confluence")

// ── Signal markers ────────────────────────────────────────────────────────────
plotshape(
     rsi_signal and not confluence,
     title     = "RSI Signal Only",
     style     = shape.circle,
     location  = location.belowbar,
     color     = color.new(color.blue, 30),
     size      = size.tiny
 )

plotshape(
     fib_signal and not confluence,
     title     = "Fib Signal Only",
     style     = shape.circle,
     location  = location.belowbar,
     color     = color.new(color.orange, 30),
     size      = size.tiny
 )

plotshape(
     confluence,
     title     = "Confluence — BUY",
     style     = shape.labelup,
     location  = location.belowbar,
     color     = color.new(color.green, 0),
     textcolor = color.white,
     text      = "BUY",
     size      = size.small
 )

// ── Strategy entries ──────────────────────────────────────────────────────────
if confluence and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    strategy.exit(
         id         = "Exit",
         from_entry = "Long",
         profit     = strategy.position_avg_price * tp_pct / 100 / syminfo.mintick,
         loss       = strategy.position_avg_price * sl_pct / 100 / syminfo.mintick
     )

// ── Stats table ───────────────────────────────────────────────────────────────
if show_table and barstate.islast
    var table t = table.new(
         position.top_right, 2, 6,
         bgcolor       = color.new(color.black, 20),
         border_color  = color.new(color.gray, 50),
         border_width  = 1,
         frame_color   = color.new(color.gray, 30),
         frame_width   = 1
     )

    // header
    table.cell(t, 0, 0, "Condition",   text_color=color.white,  text_size=size.small, bgcolor=color.new(color.navy, 20))
    table.cell(t, 1, 0, "Bars / %",    text_color=color.white,  text_size=size.small, bgcolor=color.new(color.navy, 20))

    rsi_pct  = count_bars > 0 ? str.tostring(math.round(count_rsi        / count_bars * 100, 1)) : "0"
    fib_pct  = count_bars > 0 ? str.tostring(math.round(count_fib        / count_bars * 100, 1)) : "0"
    con_pct  = count_bars > 0 ? str.tostring(math.round(count_confluence / count_bars * 100, 1)) : "0"

    table.cell(t, 0, 1, "RSI ≤ " + str.tostring(rsi_threshold) + " only",  text_color=color.new(color.blue,   0), text_size=size.small)
    table.cell(t, 1, 1, str.tostring(count_rsi)        + " (" + rsi_pct + "%)",  text_color=color.white, text_size=size.small)

    table.cell(t, 0, 2, "Fib zone only",   text_color=color.new(color.orange, 0), text_size=size.small)
    table.cell(t, 1, 2, str.tostring(count_fib)        + " (" + fib_pct + "%)",  text_color=color.white, text_size=size.small)

    table.cell(t, 0, 3, "✦ Confluence",    text_color=color.new(color.green,  0), text_size=size.small)
    table.cell(t, 1, 3, str.tostring(count_confluence) + " (" + con_pct + "%)",  text_color=color.white, text_size=size.small)

    table.cell(t, 0, 4, "Total bars",      text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(count_bars),                                text_color=color.white, text_size=size.small)

    table.cell(t, 0, 5, "TP / SL",         text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 5, str.tostring(tp_pct) + "% / " + str.tostring(sl_pct) + "%", text_color=color.white, text_size=size.small)
